# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible API, e.g. Gemini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pricing_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/pricing_db

# App Configuration
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://127.0.0.1:3000

# Pricing Guardrails
MIN_MARGIN_PERCENT=15
MAX_DISCOUNT_PERCENT=40
MAX_PRICE_CHANGE_VELOCITY=20
PRICING_AGENT_INTERVAL_MINUTES=60

# Scraper Configuration
SCRAPER_DELAY_SECONDS=2
SCRAPER_MAX_RETRIES=3

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Security — X-API-Key required on write endpoints when set
API_KEY=

# Apify — real Amazon.in / Flipkart prices (optional; simulated without it)
APIFY_TOKEN=
# APIFY_AMAZON_ACTOR=junglee~amazon-crawler
# APIFY_FLIPKART_ACTOR=sourabhbgp~flipkart-product-scraper
COMPETITOR_CACHE_HOURS=6
SIMULATED_DATA_MAX_CHANGE_PERCENT=5
